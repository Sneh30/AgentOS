NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Project URL — found in Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Anon (public) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service-role key — server-side only, bypasses RLS (optional, falls back to anon key)
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Clerk (required — authentication)
# -----------------------------------------------------------------------------
# Publishable key — found in Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Secret key — server-side only
CLERK_SECRET_KEY=your_clerk_secret_key

# -----------------------------------------------------------------------------
# Google Generative Language API (required)
# -----------------------------------------------------------------------------
# Base URL for the Google Generative Language API
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta/

# Your Google Generative Language API key
GOOGLE_API_KEY=your_google_api_key

# Model to use (optional, defaults to gemini-flash-latest)
GOOGLE_MODEL=gemini-flash-latest

# -----------------------------------------------------------------------------
# Ollama (optional — automatic fallback when Google returns 429 rate-limited)
# -----------------------------------------------------------------------------
# Base URL of a running Ollama instance
OLLAMA_API_URL=http://localhost:11434

# Model to use as fallback (defaults to gemma4:cloud)
OLLAMA_MODEL=gemma4:cloud

# -----------------------------------------------------------------------------
# GitHub Integration (optional)
# -----------------------------------------------------------------------------
# Personal access token for GitHub API calls
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Twitter / X Integration (optional)
# -----------------------------------------------------------------------------
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# -----------------------------------------------------------------------------
# Email / SMTP Integration (optional)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=anymind@agent.ai

# -----------------------------------------------------------------------------
# Composio (optional — advanced tool integrations)
# -----------------------------------------------------------------------------
# API key from https://composio.dev
COMPOSIO_API_KEY=

# Base URL override (defaults to https://backend.composio.dev)
COMPOSIO_BASE_URL=

# Project name used for session routing (defaults to "anymind-main")
COMPOSIO_PROJECT_NAME=anymind-main

# Session pool tuning
COMPOSIO_SESSION_TTL_SECONDS=3600
COMPOSIO_MAX_SESSIONS=10

# -----------------------------------------------------------------------------
# HydraDB v2 (optional — vector memory system)
# -----------------------------------------------------------------------------
# Server-side only — do NOT prefix with NEXT_PUBLIC_, this is a secret key
HYDRA_DB_API_KEY=

# Database name (v2 concept, formerly "tenant"). Auto-created on first use if missing.
HYDRA_DB_DATABASE=anymind

# Collection name (v2 concept, formerly "sub-tenant"), typically per-user (defaults to "anymind")
HYDRA_DB_COLLECTION=anymind

NEXT_PUBLIC_FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# webcmd (optional — authenticated local-browser-profile access to LinkedIn/X)
# -----------------------------------------------------------------------------
# Requires the `webcmd` CLI on PATH and a logged-in browser profile. Only ever works in
# a local/desktop deployment — never in a hosted/serverless one. Leave unset (or "false")
# to keep webcmd:* tools disabled; they degrade gracefully either way.
WEBCMD_ENABLED=false
