NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OpenRouter (replaces Google as primary LLM provider)
# -----------------------------------------------------------------------------
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Model to use (defaults to google/gemini-2.0-flash-exp if unset)
OPENROUTER_MODEL=deepseek/deepseek-chat

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Project URL — found in Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon (public) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service-role key — server-side only, bypasses RLS (optional, falls back to anon key)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Google Generative Language API (fallback when OpenRouter is unavailable)
# -----------------------------------------------------------------------------
# Base URL for the Google Generative Language API
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta/

# Your Google API key
GOOGLE_API_KEY=AIzaSyYour-google-api-key-here

# Model to use (optional, defaults to gemini-flash-latest)
GOOGLE_MODEL=gemini-flash-latest

# -----------------------------------------------------------------------------
# Ollama (optional — automatic fallback when Google returns 429 rate-limited)
# -----------------------------------------------------------------------------
# Base URL of a running Ollama instance
OLLAMA_API_URL=http://localhost:11434

# Model to use as fallback (defaults to gemma4:cloud)
OLLAMA_MODEL=gemma4:cloud

# -----------------------------------------------------------------------------
# GitHub Integration (optional)
# -----------------------------------------------------------------------------
# Personal access token for GitHub API calls
GITHUB_TOKEN=ghp_your-github-token-here

# -----------------------------------------------------------------------------
# Twitter / X Integration (optional)
# -----------------------------------------------------------------------------
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# -----------------------------------------------------------------------------
# Email / SMTP Integration (optional)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=your@email.com

# -----------------------------------------------------------------------------
# Composio (optional — advanced tool integrations)
# -----------------------------------------------------------------------------
# API key from https://composio.dev
COMPOSIO_API_KEY=ak_your-composio-key-here

# Base URL override (defaults to https://backend.composio.dev)
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_PROJECT_NAME=your-project-name

# Session pool tuning
COMPOSIO_SESSION_TTL_SECONDS=3600
COMPOSIO_MAX_SESSIONS=10

# -----------------------------------------------------------------------------
# HydraDB v2 (optional — vector memory system)
# -----------------------------------------------------------------------------
HYDRA_DB_API_KEY=sk_live_your-hydradb-key-here
HYDRA_DB_DATABASE=your-database-name
HYDRA_DB_COLLECTION=your-collection-name
NEXT_PUBLIC_FIRECRAWL_API_KEY=fc-your-firecrawl-key-here

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
